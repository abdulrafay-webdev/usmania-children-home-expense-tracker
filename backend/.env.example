# Database connection string
# Neon Postgres (Serverless Postgres):
# 1. Go to https://console.neon.tech
# 2. Sign up / Log in and create a new project (e.g. "usmania-expense-tracker")
# 3. Under "Connection Details", copy the connection string (starts with postgresql://...)
# 4. Paste it below:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# If DATABASE_URL is left empty during local testing, the backend will automatically fallback to local SQLite:
# DATABASE_URL=sqlite:///./expense_tracker.db

# ImageKit Configuration (for invoice pictures & receipt storage)
# 1. Sign up / log in at https://imagekit.io
# 2. Go to Developer Options -> API Keys
# 3. Copy Public Key, Private Key, and URL Endpoint:
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

